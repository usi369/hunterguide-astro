---
interface Props {
  slot: string;
  format?: string;
  responsive?: boolean;
  compact?: boolean;
}

const { slot, format = 'auto', responsive = true, compact = false } = Astro.props;
---

<div class={compact ? 'my-0' : 'my-4'}>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-4361379275021189"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={responsive}></ins>
  <script>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

---
import AdDisplayUnit from './AdDisplayUnit.astro';

interface Props {
  adSlot: string;
  format?: string;
  responsive?: boolean;
}

const { adSlot, format = 'auto', responsive = true } = Astro.props;
---

<div aria-hidden="true" class="h-24 sm:h-28"></div>

<aside
  aria-label="広告"
  class="fixed inset-x-0 bottom-0 z-50 px-3 pb-2 sm:px-4"
>
  <div class="mx-auto max-w-2xl overflow-hidden rounded-t-3xl border border-white/80 bg-white/95 shadow-[0_-18px_45px_rgba(15,23,42,0.14)] ring-1 ring-slate-200/70 backdrop-blur">
    <div class="relative h-20 sm:h-24">
      <span class="absolute left-1/2 top-2 z-10 -translate-x-1/2 rounded-full bg-slate-100/90 px-2.5 py-1 text-[10px] font-black tracking-wide text-slate-400">
        広告
      </span>
      <div class="h-full overflow-hidden px-2 pb-2 pt-7">
        <AdDisplayUnit slot={adSlot} format={format} responsive={responsive} compact={true} />
      </div>
    </div>
  </div>
</aside>

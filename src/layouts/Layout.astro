---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
}

const { 
  title, 
  description = 'モンスターハンターNowのモンスター情報・武器データベース',
  image = 'https://monchan3.xsrv.jp/og-image.png',
  url = 'https://monchan-encyclopedia.pages.dev',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Japanese" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="モンスターハンター,モンハンNow,モンスター,データベース" />
    
    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="モンハンNow DB" />
    
    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    
    {/* Canonical */}
    <link rel="canonical" href={url} />
    
    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    {/* Google AdSense */}
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-xxxxxxxxxxxxxxxx"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <main className="min-h-screen bg-gradient-to-b from-blue-100 to-blue-50">
      <slot />
    </main>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
import MonsterCard from '../components/MonsterCard';
import AdDisplayUnit from '../components/AdDisplayUnit.astro';
import { getMonsters } from '../lib/api';

const monsters = await getMonsters();
---

<Layout 
  title="モンスター一覧 - モンハンNow DB"
  description="モンスターハンターNowの全モンスター一覧。強さ、弱点、出現地などの詳子情報を確認できます。"
  url="https://monchan-encyclopedia.pages.dev/monsters"
>
  <div class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800 pb-24">
    {/* Header */}
    <div class="sticky top-0 bg-slate-800 border-b border-slate-700 z-20">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-white hover:text-blue-400 transition">
          ← ホーム
        </a>
        <h1 class="text-2xl font-bold text-white">モンスター一覧</h1>
        <div class="w-12"></div>
      </div>
    </div>

    {/* Content */}
    <div class="max-w-4xl mx-auto px-4 py-8">
      {monsters.length > 0 ? (
        <div>
          <p class="text-slate-300 mb-6">
            全 {monsters.length} 体のモンスター
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {monsters.map((monster) => (
              <MonsterCard client:load monster={monster} />
            ))}
          </div>
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-slate-400 text-lg">
            モンスターデータが見つかりません
          </p>
        </div>
      )}
    </div>

    {/* Fixed Bottom Ad Banner */}
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg z-50 flex justify-center">
      <div class="w-full">
        <AdDisplayUnit slot="4039552557" format="auto" responsive={true} />
      </div>
    </div>
  </div>
</Layout>

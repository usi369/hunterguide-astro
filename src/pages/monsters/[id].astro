---
import Layout from '../../layouts/Layout.astro';
import { getMonsters } from '../../lib/api';

export async function getStaticPaths() {
  const monsters = await getMonsters();
  return monsters.flatMap((monster) => {
    const paths = [
      {
        params: { id: monster.id },
        props: { monster },
      },
    ];

    if (monster.number && String(monster.number) !== String(monster.id)) {
      paths.push({
        params: { id: String(monster.number) },
        props: { monster },
      });
    }

    return paths;
  });
}

interface Props {
  monster: any;
}

const { monster } = Astro.props;

const getLabel = (item: any) => item?.label || item?.name || item;
const chips = {
  grade: (monster.grades?.length ? monster.grades : monster.grade?.split(','))?.filter(Boolean) || [],
  weakAttributes: monster.weakAttributes?.map(getLabel).filter(Boolean) || [],
  attackAttributes: monster.attackAttributes?.map(getLabel).filter(Boolean) || [],
  areas: monster.areas || monster.habitats || monster.habitat || [],
  weapons: monster.weapons || [],
};

const elementColor: Record<string, string> = {
  火: 'bg-red-600',
  水: 'bg-blue-500',
  雷: 'bg-blue-600',
  氷: 'bg-cyan-500',
  龍: 'bg-violet-700',
  毒: 'bg-red-700',
  麻痺: 'bg-red-700',
  睡眠: 'bg-indigo-700',
  無属性: 'bg-slate-500',
};

const gradeColor: Record<string, string> = {
  通常種: 'bg-sky-600',
  亜種: 'bg-orange-600',
  古龍種: 'bg-violet-700',
  次元変異: 'bg-purple-700',
  次元臨界: 'bg-rose-700',
};

const monsterSystemId = monster.id || '';
---

<Layout 
  title={`${monster.name} - モンハンNow DB`} 
  description={monster.description || `${monster.name}の詳子情報、弱点、出現地を確認。`}
  url={`https://monchan-encyclopedia.pages.dev/monsters/${monster.id}`}
>
  <div class="min-h-screen bg-sky-200 pb-24">
    {/* Header */}
    <div class="sticky top-0 bg-white/95 border-b border-slate-200 shadow-sm backdrop-blur z-20">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/monsters" class="text-sm font-bold text-slate-700 hover:text-red-600 transition">
          ← 一覧
        </a>
        <a href="/" class="text-2xl font-black text-red-600 drop-shadow-[2px_2px_0_rgba(15,23,42,0.9)] tracking-normal">
          モンちゃんDB
        </a>
        <div class="w-10"></div>
      </div>
    </div>

    {/* Content */}
    <div class="max-w-3xl mx-auto px-2 sm:px-4 py-2 sm:py-4">
      <div class="space-y-3 sm:space-y-4">
        <section class="overflow-hidden rounded-2xl bg-slate-100 shadow-sm">
          <div class="bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.9)_0_10%,transparent_11%_100%)] bg-[length:76px_76px] px-4 pb-5 pt-6">
            <div class="flex min-h-60 items-center justify-center px-2">
            {monster.imageUrl ? (
              <img
                src={monster.imageUrl}
                alt={monster.name}
                class="max-h-64 w-full object-contain drop-shadow-xl"
              />
            ) : (
              <div class="flex h-52 w-full max-w-sm items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-white/60 text-sm font-bold text-slate-400">
                モンスター画像未登録
              </div>
            )}
            </div>
            <div class="mt-4 rounded-2xl bg-white/95 p-5 text-center shadow-lg">
              {monsterSystemId && (
                <p class="mb-1 text-xs font-black tracking-wide text-slate-400">ID: {monsterSystemId}</p>
              )}
              <h1 class="text-2xl sm:text-3xl font-black text-blue-950 tracking-normal">{monster.name}</h1>
              {monster.alias && (
                <p class="mt-2 text-sm sm:text-base font-bold text-slate-500">{monster.alias}</p>
              )}
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                {monster.species && (
                  <span class="rounded-full bg-sky-600 px-4 py-1.5 text-sm font-black text-white">{monster.species}</span>
                )}
                {chips.grade.map((grade: string) => (
                  <span class={`rounded-full px-4 py-1.5 text-sm font-black text-white ${gradeColor[grade] || 'bg-slate-600'}`}>
                    {grade}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="rounded-2xl bg-white/90 p-5 shadow-sm">
          <h2 class="mb-4 text-base font-black text-blue-950">⚡ 弱点属性</h2>
          <div class="flex flex-wrap gap-2">
            {chips.weakAttributes.length > 0 ? (
              chips.weakAttributes.map((attribute: string) => (
                <span class={`rounded-full px-6 py-2 text-sm font-black text-white ${elementColor[attribute] || 'bg-blue-600'}`}>
                  {attribute}
                </span>
              ))
            ) : (
              <span class="text-sm font-bold text-slate-500">登録なし</span>
            )}
          </div>
        </section>

        <section class="rounded-2xl bg-white/90 p-5 shadow-sm">
          <h2 class="mb-4 text-base font-black text-blue-950">🔥 攻撃属性</h2>
          <div class="flex flex-wrap gap-2">
            {chips.attackAttributes.length > 0 ? (
              chips.attackAttributes.map((attribute: string) => (
                <span class={`rounded-full px-6 py-2 text-sm font-black text-white ${elementColor[attribute] || 'bg-red-700'}`}>
                  {attribute}
                </span>
              ))
            ) : (
              <span class="text-sm font-bold text-slate-500">登録なし</span>
            )}
          </div>
        </section>

        <section class="rounded-2xl bg-white/90 p-5 shadow-sm">
          <h2 class="mb-4 text-base font-black text-blue-950">🗺️ 出現情報</h2>
          <dl class="space-y-3 text-sm sm:text-base">
            {chips.areas.length > 0 && (
              <div class="grid grid-cols-[7rem_1fr] items-center gap-2">
                <dt class="font-black text-slate-500">出現エリア</dt>
                <dd class="flex flex-wrap gap-2">
                  {chips.areas.map((area: string) => (
                    <span class="rounded-full bg-emerald-700 px-4 py-1.5 text-sm font-black text-white">{area}</span>
                  ))}
                </dd>
              </div>
            )}
            {monster.debutDate && (
              <div class="grid grid-cols-[7rem_1fr] items-center gap-2">
                <dt class="font-black text-slate-500">登場日</dt>
                <dd class="font-bold text-slate-600">{monster.debutDate}</dd>
              </div>
            )}
            {monster.rarePart && (
              <div class="grid grid-cols-[7rem_1fr] items-center gap-2">
                <dt class="font-black text-slate-500">破壊推奨部位</dt>
                <dd class="font-bold text-slate-600">{monster.rarePart}</dd>
              </div>
            )}
          </dl>
        </section>

        {monster.initialTitle && (
          <section class="rounded-2xl bg-white/90 p-5 shadow-sm">
            <h2 class="mb-4 text-base font-black text-blue-950">📚 総合情報</h2>
            <dl class="space-y-3 text-sm sm:text-base">
              <div class="grid grid-cols-[7rem_1fr] items-center gap-2">
                <dt class="font-black text-slate-500">初登場作品</dt>
                <dd class="font-bold text-slate-600">{monster.initialTitle}</dd>
              </div>
            </dl>
          </section>
        )}

        <section class="rounded-2xl bg-white/90 p-5 shadow-sm">
          <h2 class="mb-4 text-base font-black text-blue-950">⚔️ 有効武器</h2>
          <div class="flex flex-wrap gap-2">
            {chips.weapons.length > 0 ? (
              chips.weapons.map((weapon: string) => (
                <span class="rounded-full bg-purple-700 px-4 py-2 text-sm font-black text-white">{weapon}</span>
              ))
            ) : (
              <span class="text-sm font-bold text-slate-500">登録なし</span>
            )}
          </div>
        </section>

        <div class="flex justify-center py-4">
          <a
            href="/monsters"
            class="rounded-full bg-white px-8 py-3 text-sm font-black text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:text-red-600 hover:shadow-md"
          >
            モンスター一覧に戻る
          </a>
        </div>
      </div>
    </div>

  </div>
</Layout>

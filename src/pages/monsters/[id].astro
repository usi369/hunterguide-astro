---
import Layout from '../../layouts/Layout.astro';
import AdDisplayUnit from '../../components/AdDisplayUnit.astro';
import { getMonsters } from '../../lib/api';

export async function getStaticPaths() {
  const monsters = await getMonsters();
  return monsters.map((monster) => ({
    params: { id: monster.id },
    props: { monster },
  }));
}

interface Props {
  monster: any;
}

const { monster } = Astro.props;
---

<Layout 
  title={`${monster.name} - モンハンNow DB`} 
  description={monster.description || `${monster.name}の詳子情報、弱点、出現地を確認。`}
  url={`https://monchan-encyclopedia.pages.dev/monsters/${monster.id}`}
>
  <div class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800">
    {/* Header */}
    <div class="sticky top-0 bg-slate-800 border-b border-slate-700 z-10">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/monsters" class="text-white hover:text-blue-400 transition">
          ← 一覧に戻る
        </a>
        <h1 class="text-2xl font-bold text-white">{monster.name}</h1>
        <div class="w-12"></div>
      </div>
    </div>

    {/* Content */}
    <div class="max-w-4xl mx-auto px-4 py-8">
      {/* Main Image */}
      <div class="mb-8 flex justify-center">
        <div class="bg-slate-700 rounded-lg p-4 w-full sm:w-96">
          {monster.imageUrl ? (
            <img
              src={monster.imageUrl}
              alt={monster.name}
              class="w-full h-auto rounded-lg"
            />
          ) : (
            <div class="w-full h-64 bg-slate-600 rounded-lg flex items-center justify-center">
              <span class="text-slate-400">No image</span>
            </div>
          )}
        </div>
      </div>

      {/* Monster Info Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        {/* Left Column */}
        <div class="space-y-4">
          {/* Basic Info */}
          <div class="bg-slate-700 rounded-lg p-4">
            <h2 class="text-lg font-bold text-white mb-4">基本情報</h2>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-300">種族</span>
                <span class="text-white font-semibold">{monster.species || '不明'}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-300">危険度</span>
                <span class="text-white font-semibold">{monster.threat || '不明'}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-300">初登場</span>
                <span class="text-white font-semibold">{monster.initialTitle || '不明'}</span>
              </div>
            </div>
          </div>

          {/* Weaknesses */}
          <div class="bg-slate-700 rounded-lg p-4">
            <h2 class="text-lg font-bold text-white mb-4">弱点属性</h2>
            <div class="flex flex-wrap gap-2">
              {monster.weaknesses && monster.weaknesses.length > 0 ? (
                monster.weaknesses.map((weakness: string) => (
                  <div
                    key={weakness}
                    class="px-3 py-1 bg-slate-600 text-white text-sm rounded-full"
                  >
                    {weakness}
                  </div>
                ))
              ) : (
                <span class="text-slate-400">弱点情報なし</span>
              )}
            </div>
          </div>
        </div>

        {/* Right Column */}
        <div class="space-y-4">
          {/* Description */}
          {monster.description && (
            <div class="bg-slate-700 rounded-lg p-4">
              <h2 class="text-lg font-bold text-white mb-4">説明</h2>
              <p class="text-slate-200 text-sm leading-relaxed">{monster.description}</p>
            </div>
          )}

          {/* Habitats */}
          {(monster.habitats || monster.habitat) && (monster.habitats?.length ?? monster.habitat?.length ?? 0) > 0 && (
            <div class="bg-slate-700 rounded-lg p-4">
              <h2 class="text-lg font-bold text-white mb-4">出現地</h2>
              <div class="space-y-2">
                {(monster.habitats || monster.habitat)?.map((habitat: string) => (
                  <div key={habitat} class="text-slate-200 text-sm">
                    • {habitat}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Advertisement */}
      <div class="my-8">
        <AdDisplayUnit slot="3109614269" format="auto" responsive={true} />
      </div>
      
      {/* Back to List Button */}
      <div class="flex justify-center mb-8">
        <a
          href="/monsters"
          class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold"
        >
          モンスター一覧に戻る
        </a>
      </div>
    </div>
  </div>
</Layout>

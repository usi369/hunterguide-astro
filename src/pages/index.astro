---
import Layout from '../layouts/Layout.astro';
import AdSmartBanner from '../components/AdSmartBanner.astro';
---

<Layout 
  title="モンハンNow DB - ハンターズガイド"
  description="モンスターハンターNowの全モンスター情報、属性別検索、詳子情報を提供しているダタベース。"
  url="https://monchan-encyclopedia.pages.dev"
>
  <div class="min-h-screen flex flex-col items-center justify-start px-4 pt-8 pb-24">
    <div class="w-full max-w-md">
      {/* Header */}
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-blue-900 mb-2">
          ハンターガイド
        </h1>
        <p class="text-gray-600">
          Hunter's Pocket Note
        </p>
      </div>

      {/* Menu Buttons */}
      <div class="flex flex-col gap-5">
        {/* Monster List Button */}
        <a href="/monsters" class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white font-bold py-5 px-6 rounded-2xl transition-all duration-200 flex items-center justify-between shadow-xl shadow-blue-500/25 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-blue-500/30 border border-white/20">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🐉</span>
            <div class="text-left">
              <div class="font-bold">モンスター一覧</div>
              <div class="text-sm font-normal">全モンスターの一覧</div>
            </div>
          </div>
          <span class="text-xl">›</span>
        </a>

        {/* Attribute Search Button */}
        <a href="/attribute-search" class="w-full bg-gradient-to-r from-orange-500 to-rose-500 hover:from-orange-600 hover:to-rose-600 text-white font-bold py-5 px-6 rounded-2xl transition-all duration-200 flex items-center justify-between shadow-xl shadow-orange-500/25 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-orange-500/30 border border-white/20">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🔥</span>
            <div class="text-left">
              <div class="font-bold">属性別検索</div>
              <div class="text-sm font-normal">弱点・攻撃属性で絞り込み</div>
            </div>
          </div>
          <span class="text-xl">›</span>
        </a>

        {/* Weapon Material Button */}
        <a href="/weapons" class="w-full bg-gradient-to-r from-slate-800 to-blue-700 hover:from-slate-900 hover:to-blue-800 text-white font-bold py-5 px-6 rounded-2xl transition-all duration-200 flex items-center justify-between shadow-xl shadow-blue-900/20 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-blue-900/25 border border-white/20">
          <div class="flex items-center gap-3">
            <span class="text-2xl">⚔️</span>
            <div class="text-left">
              <div class="font-bold">武器素材検索</div>
              <div class="text-sm font-normal">素材から作れる武器種</div>
            </div>
          </div>
          <span class="text-xl">›</span>
        </a>
      </div>

      {/* Footer Info */}
      <div class="mt-12 text-center text-sm text-gray-600">
        <p>✦ 64体のモンスターデータを収録 ✦</p>
      </div>
    </div>
  </div>

  <AdSmartBanner adSlot="8525592479" format="horizontal" responsive={true} />
</Layout>

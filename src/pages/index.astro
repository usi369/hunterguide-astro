---
import Layout from '../layouts/Layout.astro';
import AdDisplayUnit from '../components/AdDisplayUnit.astro';
---

<Layout 
  title="モンハンNow DB - ハンターズガイド"
  description="モンスターハンターNowの全モンスター情報、属性別検索、詳子情報を提供しているダタベース。"
  url="https://monchan-encyclopedia.pages.dev"
>
  <div class="min-h-screen flex flex-col items-center justify-center px-4 py-8 pb-24">
    <div class="w-full max-w-md">
      {/* Header */}
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-blue-900 mb-2">
          ハンターガイド
        </h1>
        <p class="text-gray-600">
          Hunter's Pocket Note
        </p>
      </div>

      {/* Menu Buttons */}
      <div class="space-y-6">
        {/* Monster List Button */}
        <a href="/monsters">
          <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-4 px-6 rounded-lg transition-colors flex items-center justify-between shadow-lg">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🐉</span>
              <div class="text-left">
                <div class="font-bold">モンスター一覧</div>
                <div class="text-sm font-normal">全モンスターの一覧</div>
              </div>
            </div>
            <span class="text-xl">›</span>
          </button>
        </a>

        {/* Attribute Search Button */}
        <a href="/attribute-search">
          <button class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 px-6 rounded-lg transition-colors flex items-center justify-between shadow-lg">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🔥</span>
              <div class="text-left">
                <div class="font-bold">属性別検索</div>
                <div class="text-sm font-normal">弱点・攻撃属性で絞り込み</div>
              </div>
            </div>
            <span class="text-xl">›</span>
          </button>
        </a>
      </div>

      {/* Footer Info */}
      <div class="mt-12 text-center text-sm text-gray-600">
        <p>✦ 64体のモンスターデータを収録 ✦</p>
      </div>
    </div>
  </div>

  {/* Fixed Bottom Ad Banner */}
  <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg z-50 flex justify-center">
    <div class="w-full">
      <AdDisplayUnit slot="8525592479" format="auto" responsive={true} />
    </div>
  </div>
</Layout>

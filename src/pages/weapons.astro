---
import Layout from '../layouts/Layout.astro';
import AdSmartBanner from '../components/AdSmartBanner.astro';
import { getMonsterWeaponSummaries, WEAPON_CATEGORY_ORDER } from '../lib/weapons';

const summaries = await getMonsterWeaponSummaries();
const weaponCategories = WEAPON_CATEGORY_ORDER;
const totalWeapons = summaries.reduce((sum, summary) => sum + summary.weaponCount, 0);
const shortLabel: Record<string, string> = {
  片手剣: '片',
  双剣: '双',
  大剣: '大',
  太刀: '太',
  ハンマー: '鎚',
  狩猟笛: '笛',
  ランス: '槍',
  ガンランス: '銃槍',
  スラッシュアックス: '斧',
  チャージアックス: '盾斧',
  操虫棍: '棍',
  ライトボウガン: '軽弩',
  ヘビィボウガン: '重弩',
  弓: '弓',
};
---

<Layout
  title="武器素材検索 - モンハンNow DB"
  description="モンスターハンターNowのモンスター素材から作れる武器種を一覧で確認できます。"
  url="https://monchandb.com/weapons"
>
  <div class="min-h-screen bg-sky-100 pb-24">
    <div class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
      <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-3">
        <a href="/" class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-black text-slate-600 shadow-sm transition hover:-translate-y-0.5 hover:text-blue-900 hover:shadow-md sm:px-4">
          ← 戻る
        </a>
        <div class="min-w-0 text-center">
          <h1 class="truncate text-2xl font-bold tracking-normal text-blue-900 sm:text-3xl">
            武器素材検索
          </h1>
          <p class="hidden text-xs font-bold text-gray-500 sm:block">
            Weapon Material Index
          </p>
        </div>
        <a href="/monsters" class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-black text-slate-600 shadow-sm transition hover:-translate-y-0.5 hover:text-blue-900 hover:shadow-md sm:px-4">
          一覧へ
        </a>
      </div>
    </div>

    <main class="mx-auto max-w-4xl px-3 py-4 sm:px-4 sm:py-6">
      <section class="sticky top-[65px] z-10 mb-4 rounded-xl border border-white/80 bg-sky-100/90 p-2 shadow-sm backdrop-blur">
        <div class="flex gap-2 overflow-x-auto pb-1">
          {weaponCategories.map((category) => (
            <div class="flex min-w-[4.4rem] flex-col items-center justify-center rounded-lg border border-white/80 bg-white/80 px-2 py-2 shadow-sm" title={category}>
              <span class="flex h-8 w-8 items-center justify-center rounded-md bg-slate-950 text-[11px] font-black text-white">
                {shortLabel[category] || category.slice(0, 1)}
              </span>
              <span class="mt-1 text-[10px] font-black leading-tight text-slate-600">{category}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-3 rounded-xl border border-white/80 bg-white/70 px-4 py-3 shadow-sm">
        <div class="flex items-center justify-between gap-3 text-sm font-black text-slate-500">
          <span>素材元モンスター <strong class="text-blue-950">{summaries.length}体</strong></span>
          <span>武器データ <strong class="text-blue-950">{totalWeapons}件</strong></span>
        </div>
      </section>

      <section class="space-y-3">
        {summaries.map((summary) => (
          <article class="rounded-xl border border-white/80 bg-white/80 p-3 shadow-md shadow-sky-900/10 backdrop-blur">
            <div class="flex gap-3">
              <a href={`/monsters/${summary.id}`} class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm sm:h-20 sm:w-20">
                {summary.iconUrl ? (
                  <img src={summary.iconUrl} alt={summary.monster} loading="lazy" class="h-full w-full object-contain p-1" />
                ) : (
                  <span class="text-[10px] font-black text-slate-300">No image</span>
                )}
              </a>

              <div class="min-w-0 flex-1">
                <a href={`/monsters/${summary.id}`} class="block truncate text-lg font-black tracking-normal text-blue-950 sm:text-2xl">
                  {summary.monster}
                </a>
                <div class="mt-1 flex flex-wrap gap-1.5">
                  {summary.grade && (
                    <span class="rounded-md bg-indigo-100 px-2 py-1 text-[11px] font-black text-indigo-700">
                      {summary.grade}
                    </span>
                  )}
                  {summary.species && (
                    <span class="rounded-md bg-sky-100 px-2 py-1 text-[11px] font-black text-sky-700">
                      {summary.species}
                    </span>
                  )}
                </div>
              </div>
            </div>

            <div class="mt-3 flex gap-1.5 overflow-x-auto pb-1">
              {weaponCategories.map((category) => {
                const available = summary.categories.includes(category);
                return (
                  <span
                    class:list={[
                      'flex h-9 min-w-9 items-center justify-center rounded-md border text-[11px] font-black transition',
                      available
                        ? 'border-emerald-200 bg-emerald-50 text-slate-950 shadow-sm'
                        : 'border-slate-100 bg-white/40 text-slate-300 opacity-45',
                    ]}
                    title={`${summary.monster}: ${category}${available ? '' : 'なし'}`}
                  >
                    {shortLabel[category] || category.slice(0, 1)}
                  </span>
                );
              })}
            </div>
          </article>
        ))}
      </section>
    </main>

    <AdSmartBanner adSlot="3306379833" format="horizontal" responsive={true} />
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import AdDisplayUnit from '../components/AdDisplayUnit.astro';
import { getMonsters } from '../lib/api';

const monsters = await getMonsters();

const ATTRIBUTES = [
  { name: '火', label: '火', color: 'bg-red-600', icon: '🔥' },
  { name: '水', label: '水', color: 'bg-blue-600', icon: '💧' },
  { name: '雷', label: '雷', color: 'bg-yellow-500', icon: '⚡' },
  { name: '氷', label: '氷', color: 'bg-cyan-400', icon: '❄️' },
  { name: '龍', label: '龍', color: 'bg-purple-600', icon: '🐉' },
];

// Build attribute map - filter monsters by weakAttributes label
const attributeMap: Record<string, any[]> = {};
ATTRIBUTES.forEach((attr) => {
  attributeMap[attr.name] = monsters.filter(m =>
    m.weakAttributes && m.weakAttributes.some((wa: any) => wa.label === attr.label)
  );
});
---

<Layout 
  title="属性別検索 - モンハンNow DB"
  description="モンスターハンターNowのモンスターを弱点属性で検索。火、水、雷、氷、龍属性を指定して検索できます。"
  url="https://monchan-encyclopedia.pages.dev/attribute-search"
>
  <div class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800">
    {/* Header */}
    <div class="sticky top-0 bg-slate-800 border-b border-slate-700 z-10">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-white hover:text-blue-400 transition">
          ← ホーム
        </a>
        <h1 class="text-2xl font-bold text-white">属性別検索</h1>
        <div class="w-12"></div>
      </div>
    </div>

    {/* Content */}
    <div class="max-w-6xl mx-auto px-4 py-8">
      {/* Advertisement */}
      <div class="mb-8">
        <AdDisplayUnit slot="3306379833" format="auto" responsive={true} />
      </div>
      
      {/* Attribute Sections */}
      <div class="space-y-12">
        {ATTRIBUTES.map((attr) => (
          <div key={attr.name}>
            <div class="flex items-center gap-3 mb-6">
              <span class="text-3xl">{attr.icon}</span>
              <h2 class={`text-xl font-bold text-white ${attr.color} px-4 py-2 rounded-lg`}>
                {attr.name}が弱点 ({attributeMap[attr.name].length}体)
              </h2>
            </div>

            {attributeMap[attr.name].length > 0 ? (
              <div class="grid grid-cols-5 gap-4">
                {attributeMap[attr.name].map((monster) => (
                  <a href={`/monsters/${monster.id}`} key={monster.id}>
                    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden cursor-pointer h-full">
                      {/* Icon Container */}
                      <div class="w-full aspect-square bg-gradient-to-b from-blue-100 to-blue-50 flex items-center justify-center relative overflow-hidden">
                        {monster.iconUrl ? (
                          <img
                            src={monster.iconUrl}
                            alt={monster.name}
                            class="w-full h-full object-contain p-2"
                          />
                        ) : (
                          <div class="flex flex-col items-center justify-center w-full h-full">
                            <span class="text-3xl mb-2">🐉</span>
                          </div>
                        )}
                      </div>

                      {/* Name */}
                      <div class="p-2 text-center">
                        <h3 class="font-bold text-sm text-blue-900 line-clamp-2">
                          {monster.name}
                        </h3>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div class="text-center py-8">
                <p class="text-slate-400">
                  {attr.name}が弱点のモンスターはいません
                </p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
